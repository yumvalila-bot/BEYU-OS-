# BEYU OS ECOSYSTEM — example environment configuration
# BEYU OS (control plane) + BEYU HEALTH OS (health sector OS)
# Copy to `.env` and fill real values. NEVER commit `.env` or credentials.
# Every value below is placeholder, not working secret.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
BEYU_ENV=development           # development | testing | staging | production
PORT=4000
HEALTH_API_PORT=4001
LOG_LEVEL=debug                # debug | info | warn | error

# ---------------------------------------------------------------------------
# Database — PostgreSQL is system of record
# ---------------------------------------------------------------------------
# 'pglite'   : PostgreSQL 16 compiled to WASM, in-process. Local dev and CI only.
# 'postgres' : PostgreSQL server. Required for staging/production.
#
# Local development MUST stay on pglite or a local/compose Postgres.
# Do not point DATABASE_URL / HEALTH_DATABASE_URL at the production
# Supabase project from a laptop. Production identity is documented in
# infra/supabase/project-identity.json (project ref only — no secrets).
DATABASE_DRIVER=pglite
DATABASE_URL=postgresql://beyu:CHANGE_ME@localhost:5432/beyu_os
HEALTH_DATABASE_URL=postgresql://beyu_health:CHANGE_ME@localhost:5433/beyu_health_os
DIRECT_URL=
PGLITE_DATA_DIR=.data/pglite
HEALTH_PGLITE_DATA_DIR=.data/health_pglite

# Destructive DB commands are blocked against Supabase and production.
# Leave these unset. They exist only as explicit break-glass overrides.
ALLOW_SUPABASE_MIGRATE=
ALLOW_PRODUCTION_MIGRATE=

# ---------------------------------------------------------------------------
# Cache / sessions
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Must be at least 32 characters. API refuses to start in production with shorter key.
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_long_random_value_at_least_32_chars
JWT_ISSUER=beyu-os
HEALTH_JWT_ISSUER=beyu-health-os
ACCESS_TOKEN_TTL=3600          # seconds
REFRESH_TOKEN_TTL=1209600      # seconds (14 days)

# ---------------------------------------------------------------------------
# Object storage — documents (S3-compatible)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=filesystem      # s3 | filesystem
STORAGE_LOCAL_PATH=.data/storage
HEALTH_STORAGE_LOCAL_PATH=.data/health_storage
S3_ENDPOINT=
S3_BUCKET=beyu-os-documents
HEALTH_S3_BUCKET=beyu-health-os-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Events — Kafka-compatible broker
# ---------------------------------------------------------------------------
EVENT_DRIVER=inmemory          # kafka | inmemory
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=beyu-os
HEALTH_KAFKA_CLIENT_ID=beyu-health-os

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
REQUIRE_MFA_HIGH_IMPACT=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# AI services (Noelia, HIVE) — governed
# ---------------------------------------------------------------------------
# AI agents never receive direct DB access and cannot bypass policy engine.
# These configure model provider only. apiKeyRef is REFERENCE not secret material.
AI_PROVIDER=
AI_API_KEY_REF=                # reference to secret manager path or env var name, never secret itself
AI_MODEL=stub-deterministic
AI_DRIVER=stub                 # stub | openai-compatible
AI_ENABLED=false               # kill switch, off by default in production unless real provider configured
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=30000

# Health OS specific AI (inherits same governance)
HEALTH_AI_ENABLED=true
HEALTH_AI_DRIVER=stub

# ---------------------------------------------------------------------------
# BEYU HEALTH OS — Web (browser-safe values only)
# ---------------------------------------------------------------------------
# The browser talks to NestJS, never to Postgres or the Supabase service role.
# Leave NEXT_PUBLIC_HEALTH_API_URL empty to use same-origin /api/v1 (Next rewrites to Nest).
NEXT_PUBLIC_HEALTH_API_URL=
HEALTH_API_INTERNAL_URL=http://127.0.0.1:4001
NEXT_PUBLIC_BEYU_OS_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Supabase — Health OS associated project (server-side)
# ---------------------------------------------------------------------------
# Production project ref (NOT a secret): ztulvqnvtxmiejnvdcit
# Project B (siyzygezdmlxbvwttrdz) is NOT associated with this application.
#
# Public/publishable keys may appear in a browser only if a future client
# uses Supabase Auth directly. Secret/service-role keys MUST stay on NestJS.
# Never put SUPABASE_SECRET_KEY in NEXT_PUBLIC_* or in apps/.
#
# Leave these blank in local development. Fill them only in the matching
# environment (Vercel/server secrets for staging/production).
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Feature Flags — Health OS
# ---------------------------------------------------------------------------
FF_OPHTHALMOLOGY_ADVANCED=true
FF_TELEMEDICINE_ENABLED=true
FF_AI_NOELIA=true
FF_AMBULANCE_TRACKING=true
FF_OFFLINE_MODE=true
FF_FHIR_R4=true
FF_DICOM_WEB=true
FF_MTUHA_REPORTING=true
FF_NHIF_INTEGRATION=false

# ---------------------------------------------------------------------------
# BEYU AGRICULTURE OS (services/beyu-agriculture-api, port 4002)
# Sector OS under AGRICULTURE LLC. Own database (port 5434) — never shared
# with the control plane or Health OS. See docker-compose.agriculture.yml.
# ---------------------------------------------------------------------------
AGRICULTURE_API_PORT=4002
AGRICULTURE_DATABASE_URL=postgresql://beyu_agriculture:CHANGE_ME@localhost:5434/beyu_agriculture_os
# Local no-server mode: PGLite storage directory (mutually exclusive with the
# Postgres URL above; the driver picks AGRICULTURE_DATABASE_URL first).
AGRICULTURE_PGLITE_DATA_DIR=.data/agriculture_pglite
# JWT issuer/audience for this OS's own identity plane (separate from BEYU OS
# and Health OS tokens — a control-plane token is not valid here).
AGRICULTURE_JWT_ISSUER=beyu-agriculture-os
