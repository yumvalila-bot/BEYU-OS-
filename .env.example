# BEYU OS ECOSYSTEM — example environment configuration
# BEYU OS (control plane) + BEYU HEALTH OS (health sector OS)
# Copy to `.env` and fill real values. NEVER commit `.env` or credentials.
# Every value below is placeholder, not working secret.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
BEYU_ENV=development           # development | testing | staging | production
PORT=4000
HEALTH_API_PORT=4001
LOG_LEVEL=debug                # debug | info | warn | error

# ---------------------------------------------------------------------------
# Database — PostgreSQL is system of record
# ---------------------------------------------------------------------------
# 'pglite'   : PostgreSQL 16 compiled to WASM, in-process. Local dev and CI only.
# 'postgres' : PostgreSQL server. Required for staging/production.
DATABASE_DRIVER=pglite
DATABASE_URL=postgresql://beyu:CHANGE_ME@localhost:5432/beyu_os
HEALTH_DATABASE_URL=postgresql://beyu_health:CHANGE_ME@localhost:5433/beyu_health_os
PGLITE_DATA_DIR=.data/pglite
HEALTH_PGLITE_DATA_DIR=.data/health_pglite

# ---------------------------------------------------------------------------
# Cache / sessions
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Must be at least 32 characters. API refuses to start in production with shorter key.
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_long_random_value_at_least_32_chars
JWT_ISSUER=beyu-os
HEALTH_JWT_ISSUER=beyu-health-os
ACCESS_TOKEN_TTL=3600          # seconds
REFRESH_TOKEN_TTL=1209600      # seconds (14 days)

# ---------------------------------------------------------------------------
# Object storage — documents (S3-compatible)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=filesystem      # s3 | filesystem
STORAGE_LOCAL_PATH=.data/storage
HEALTH_STORAGE_LOCAL_PATH=.data/health_storage
S3_ENDPOINT=
S3_BUCKET=beyu-os-documents
HEALTH_S3_BUCKET=beyu-health-os-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Events — Kafka-compatible broker
# ---------------------------------------------------------------------------
EVENT_DRIVER=inmemory          # kafka | inmemory
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=beyu-os
HEALTH_KAFKA_CLIENT_ID=beyu-health-os

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
REQUIRE_MFA_HIGH_IMPACT=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# AI services (Noelia, HIVE) — governed
# ---------------------------------------------------------------------------
# AI agents never receive direct DB access and cannot bypass policy engine.
# These configure model provider only. apiKeyRef is REFERENCE not secret material.
AI_PROVIDER=
AI_API_KEY_REF=                # reference to secret manager path or env var name, never secret itself
AI_MODEL=stub-deterministic
AI_DRIVER=stub                 # stub | openai-compatible
AI_ENABLED=false               # kill switch, off by default in production unless real provider configured
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=30000

# Health OS specific AI (inherits same governance)
HEALTH_AI_ENABLED=true
HEALTH_AI_DRIVER=stub

# ---------------------------------------------------------------------------
# BEYU HEALTH OS — Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HEALTH_API_URL=http://localhost:4001
NEXT_PUBLIC_BEYU_OS_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Feature Flags — Health OS
# ---------------------------------------------------------------------------
FF_OPHTHALMOLOGY_ADVANCED=true
FF_TELEMEDICINE_ENABLED=true
FF_AI_NOELIA=true
FF_AMBULANCE_TRACKING=true
FF_OFFLINE_MODE=true
FF_FHIR_R4=true
FF_DICOM_WEB=true
FF_MTUHA_REPORTING=true
FF_NHIF_INTEGRATION=false
