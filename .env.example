# BEYU OS — example environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env` or any file
# containing real credentials: `.gitignore` excludes them deliberately.
# Every value below is a placeholder, not a working secret.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
BEYU_ENV=development           # development | testing | staging | production
PORT=4000
LOG_LEVEL=debug                # debug | info | warn | error

# ---------------------------------------------------------------------------
# Database — PostgreSQL is the system of record
# ---------------------------------------------------------------------------
# 'pglite'   : PostgreSQL 16 compiled to WASM, in-process. Local dev and CI
#              only. Real PostgreSQL semantics, but single-process.
# 'postgres' : a PostgreSQL server. Required for staging and production.
DATABASE_DRIVER=pglite
DATABASE_URL=postgresql://beyu:CHANGE_ME@localhost:5432/beyu_os
PGLITE_DATA_DIR=.data/pglite

# ---------------------------------------------------------------------------
# Cache / sessions
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Must be at least 32 characters. The API refuses to start in production with
# a shorter key. Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_long_random_value_at_least_32_chars
JWT_ISSUER=beyu-os
ACCESS_TOKEN_TTL=3600          # seconds
REFRESH_TOKEN_TTL=1209600      # seconds (14 days)

# ---------------------------------------------------------------------------
# Object storage — documents (S3-compatible)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=filesystem      # s3 | filesystem
STORAGE_LOCAL_PATH=.data/storage
S3_ENDPOINT=
S3_BUCKET=beyu-os-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Events — Kafka-compatible broker
# ---------------------------------------------------------------------------
EVENT_DRIVER=inmemory          # kafka | inmemory
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=beyu-os

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
REQUIRE_MFA_HIGH_IMPACT=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# AI services (Noelia, HIVE)
# ---------------------------------------------------------------------------
# AI agents never receive direct database access and cannot bypass the policy
# engine. These configure the model provider only.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
