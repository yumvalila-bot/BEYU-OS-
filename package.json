{
  "name": "beyu-os",
  "version": "1.0.0",
  "private": true,
  "description": "BEYU OS — organizational, governance, strategic, risk, compliance and capital-allocation control plane of BEYU FAMILY TRUST",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @beyu/api db:migrate",
    "db:seed": "pnpm --filter @beyu/api db:seed",
    "db:reset": "pnpm --filter @beyu/api db:reset"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
